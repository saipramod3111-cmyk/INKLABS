# --- InkLabs API ---
PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string. The database is created automatically by `npm run db:setup`.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/inklabs

# Secret used to sign JWT session cookies
JWT_SECRET=change-me-in-production

# Payments
#   mock   -> built-in fake Stripe checkout page (no network, no keys needed)
#   stripe -> real Stripe Checkout in test mode (requires a sk_test_... key)
STRIPE_MODE=mock
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
